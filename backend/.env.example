DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/marketing_os
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=your-openai-api-key
STABLE_DIFFUSION_API_URL=http://stable-diffusion:7860
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated list of origins allowed to call this API (no trailing slash)
CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030

# Optional: real SEO audit data (free Google Cloud API key). Without it,
# PageSpeed Insights' shared quota is exhausted almost instantly.
PAGESPEED_API_KEY=

# Optional: paid third-party backlink data provider (Ahrefs/Moz/Majestic/DataForSEO).
# Without it, backlink profile comes back empty instead of fabricated.
BACKLINK_API_KEY=

# Free: Google Search Console OAuth (real organic traffic/ranking data).
# Create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials and enable the
# "Search Console API" for the project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3031/api/v1/integrations/google/callback
FRONTEND_URL=http://localhost:3030

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
FACEBOOK_ADS_ACCESS_TOKEN=
LINKEDIN_ADS_ACCESS_TOKEN=
